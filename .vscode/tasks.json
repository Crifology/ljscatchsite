{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LJ's Catch: local web server",
      "type": "process",
      "command": "node",
      "args": ["server.cjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "lj-local-server",
        "pattern": { "regexp": "^(.*):(\\d+): (.*)$", "file": 1, "line": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting",
          "endsPattern": "^Serving HTTP on"
        }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}
