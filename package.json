{
  "name": "ljs-catch-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && netlify dev",
    "build": "node scripts/build-site.cjs",
